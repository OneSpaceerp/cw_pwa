{
  "installCommand": "cd frontend && npm install --no-audit --no-fund",
  "buildCommand": "cd frontend && npm run build:standalone",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://onespace.cw-eg.com/api/:path*" },
    { "source": "/files/:path*", "destination": "https://onespace.cw-eg.com/files/:path*" },
    { "source": "/private/:path*", "destination": "https://onespace.cw-eg.com/private/:path*" },
    { "source": "/((?!assets/|manifest/|sw\\.js|manifest\\.webmanifest).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
