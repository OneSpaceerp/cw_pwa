{
  "name": "cw-pwa-frontend",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode frappe",
    "build": "vite build --mode frappe && node scripts/copy-entry.mjs",
    "build:standalone": "vite build --mode standalone",
    "preview:standalone": "vite preview --mode standalone",
    "test": "node --test tests/*.test.mjs",
    "mock": "node scripts/mock-server.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "build:native": "vite build --mode native",
    "native:sync": "npm run build:native && cap sync android",
    "native:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.3.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@lucide/vue": "^1.52.0",
    "idb": "^8.0.3",
    "leaflet": "1.9.4",
    "vue": "^3.5.12",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  }
}
